rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Students can read/write their own profile
    match /students/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }
    
    // Admissions: students can create, admins can read/write
    match /admissions/{admissionId} {
      allow create: if request.auth != null;
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager'];
    }
    
    // Payments: students read own, admins read/write all
    match /payments/{paymentId} {
      allow read: if request.auth != null && 
        (resource.data.studentId == request.auth.uid || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Seats: admins read/write, students read own
    match /seats/{seatId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Membership plans: all authenticated read, admins write
    match /membershipPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Attendance: students read own, admins read/write all
    match /attendance/{attendanceId} {
      allow read: if request.auth != null && 
        (resource.data.studentId == request.auth.uid || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Users: admins read/write, students read own
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow write: if request.auth != null && 
        (request.auth.uid == userId || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
    }
    
    // Settings: admins only
    match /settings/{settingId} {
      allow read, write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Documents: students read own, admins read all
    match /documents/{documentId} {
      allow read: if request.auth != null && 
        (resource.data.studentId == request.auth.uid || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Global (shared) documents uploaded from the Documents page
    // Read: any signed-in user (the list is shown to Admin/Manager/Student dashboards)
    // Write: any signed-in user can add; only admins/managers can modify/remove
    match /globalDocuments/{documentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager'];
    }

    // Parts of oversized global documents (>1MB total, split into ~700KB chunks)
    match /globalDocumentChunks/{chunkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager'];
    }

    // Per-student admission documents (aadhaar/selfie stored as base64)
    match /studentDocuments/{studentId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == studentId ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow create: if request.auth != null;
    }

    // Complaints: students create/read own, admins read/write all
    match /complaints/{complaintId} {
      allow read: if request.auth != null && 
        (resource.data.studentId == request.auth.uid || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow create: if request.auth != null;
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
    
    // Renewals: students read own, admins read/write
    match /renewals/{renewalId} {
      allow read: if request.auth != null && 
        (resource.data.studentId == request.auth.uid || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']));
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner/Admin', 'Manager']);
    }
  }
}