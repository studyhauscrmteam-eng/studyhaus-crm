rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasRole(roles) {
      return userExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }
    // Include legacy variants: some docs store "Admin"/"Owner" instead of "Owner/Admin"
    function isStaff() {
      return hasRole(['Owner/Admin', 'Owner', 'Admin', 'Manager', 'Employee']);
    }
    function isManagerUp() {
      return hasRole(['Owner/Admin', 'Owner', 'Admin', 'Manager']);
    }
    function isOwner() {
      return hasRole(['Owner/Admin', 'Owner', 'Admin']);
    }
    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isOwnDoc() {
      return signedIn() && resource.data.get('studentId', null) == request.auth.uid;
    }

    // ---------- users ----------
    // Register writes users/{uid} right after Auth creation, so self-create must not
    // depend on get(users/uid) (doc doesn't exist yet).
    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if isSelf(userId) || isStaff();
      allow update: if isSelf(userId) || isManagerUp();
      allow delete: if isOwner();
    }

    // Legacy role-named collections used as login fallback (read-only fallback).
    match /Manager/{docId} {
      allow read: if signedIn() && (request.auth.uid == docId || isStaff());
      allow write: if isManagerUp();
    }
    match /Employee/{docId} {
      allow read: if signedIn() && (request.auth.uid == docId || isStaff());
      allow write: if isManagerUp();
    }
    match /Owner/{docId} {
      allow read: if signedIn() && (request.auth.uid == docId || isStaff());
      allow write: if isOwner();
    }
    match /Admin/{docId} {
      allow read: if signedIn() && (request.auth.uid == docId || isStaff());
      allow write: if isOwner();
    }

    // ---------- students (FIXED: admins could not read at all before) ----------
    match /students/{studentId} {
      allow read: if isStaff() || isSelf(studentId);
      allow create: if signedIn();
      allow update: if isStaff() || isSelf(studentId);
      allow delete: if isManagerUp();
    }

    // ---------- admissions ----------
    match /admissions/{admissionId} {
      allow create: if signedIn();
      allow read: if isStaff();
      allow update, delete: if isManagerUp();
    }

    // ---------- payments (FIXED: students could not create payment requests) ----------
    match /payments/{paymentId} {
      allow read: if isStaff() || isOwnDoc();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---------- seats ----------
    match /seats/{seatId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---------- membership plans ----------
    match /membershipPlans/{planId} {
      allow read: if signedIn();
      allow write: if isManagerUp();
    }

    // ---------- attendance (FIXED: students could not check in) ----------
    match /attendance/{attendanceId} {
      allow read: if isStaff() || isOwnDoc();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---------- settings ----------
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isManagerUp();
    }

    // ---------- documents ----------
    match /documents/{documentId} {
      allow read: if isStaff() || isOwnDoc();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    match /globalDocuments/{documentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    match /globalDocumentChunks/{chunkId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    match /studentDocuments/{studentId} {
      allow read: if isStaff() || isSelf(studentId);
      allow create: if signedIn();
      allow update, delete: if isStaff() || isSelf(studentId);
    }

    // ---------- complaints ----------
    match /complaints/{complaintId} {
      allow read: if isStaff() || isOwnDoc();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---------- renewals ----------
    match /renewals/{renewalId} {
      allow read: if isStaff() || isOwnDoc();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---------- MISSING collections (were default-deny = permission-denied) ----------
    match /visitors/{visitorId} {
      allow read, write: if isStaff();
    }
    match /visitorPurposes/{purposeId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow write: if isManagerUp();
    }
    match /expenseCategories/{categoryId} {
      allow read: if signedIn();
      allow write: if isManagerUp();
    }
    match /messageTemplates/{templateId} {
      allow read, write: if isStaff();
    }
    match /messageLogs/{logId} {
      allow read, write: if isStaff();
    }
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /reminders/{reminderId} {
      allow read, write: if isStaff();
    }
    match /staff/{staffId} {
      allow read: if isStaff();
      allow write: if isManagerUp();
    }
    match /tasks/{taskId} {
      allow read, write: if isStaff();
    }
  }
}
