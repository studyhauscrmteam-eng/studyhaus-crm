rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    // ─── Role helpers ────────────────────────────────────────────────────────
    // IMPORTANT: getUserRole() does a get() on /users/{auth.uid}.
    // Do NOT call it inside a rule for /users/{userId} when userId == auth.uid,
    // because that creates a circular read that returns PERMISSION_DENIED.
    // Use isSelfRead(userId) first to short-circuit before calling isStaff().
    function getUserRole() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDocPath)
        ? get(userDocPath).data.get('role', null)
        : null;
    }

    // Returns true when the authenticated user is reading/writing their own document.
    // This check involves NO get() call and cannot create a circular dependency.
    function isSelfRead(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function isOwnerOrAdmin() {
      let role = getUserRole();
      return isLoggedIn() && (role == "Owner" || role == "Admin" || role == "Owner/Admin");
    }

    function isManager() {
      return isLoggedIn() && getUserRole() == "Manager";
    }

    function isEmployee() {
      return isLoggedIn() && getUserRole() == "Employee";
    }

    function isStaff() {
      return isOwnerOrAdmin() || isManager() || isEmployee();
    }

    function isOwnStudentRecord(studentId) {
      return isLoggedIn() && (
        request.auth.uid == studentId ||
        (resource != null && resource.data != null && resource.data.email == request.auth.token.email)
      );
    }

    match /users/{userId} {
      // Self-read is checked first via isSelfRead() which does NOT call getUserRole(),
      // avoiding the circular get(/users/{uid}) inside isStaff() -> getUserRole().
      // This was the root cause of PERMISSION_DENIED for newly registered users:
      // getUserRole() called get(/users/{uid}) while /users/{uid} was the very doc
      // being read, causing the Firestore rules evaluator to return PERMISSION_DENIED.
      allow read: if isSelfRead(userId) || isStaff();
      // A user can only CREATE their own doc with a valid role; admins can write anything.
      allow create: if (isSelfRead(userId) &&
         request.resource.data.role in ["Student", "Employee", "Manager", "Owner/Admin", "Owner", "Admin"]) || isOwnerOrAdmin();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /students/{studentId} {
      allow read: if isStaff() || isOwnStudentRecord(studentId);
      allow write: if isOwnerOrAdmin() || isManager();
      allow create: if isLoggedIn() && request.auth.uid == studentId;
    }

    match /studentDocuments/{studentId} {
      allow read, write: if isStaff() || (isLoggedIn() && request.auth.uid == studentId);
    }

    match /oldStudents/{studentId} {
      allow read: if isStaff();
      allow write: if isOwnerOrAdmin() || isManager();
    }

    match /admissions/{admissionId} {
      allow read, write: if isStaff();
      allow read, write: if isLoggedIn() && request.auth.uid == admissionId;
      allow create: if request.resource.data.source == "Website";
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || (isLoggedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isStaff() || (isLoggedIn() && request.resource.data.studentId == request.auth.uid && request.resource.data.status == "pending");
      allow update, delete: if isOwnerOrAdmin() || isManager();
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff() || (isLoggedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if isStaff() || (isLoggedIn() && request.resource.data.studentId == request.auth.uid);
      allow delete: if isOwnerOrAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isStaff() || (isLoggedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isStaff() || (isLoggedIn() && request.resource.data.studentId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isOwnerOrAdmin();
    }

    match /renewals/{renewalId} {
      allow read: if isStaff() || (isLoggedIn() && resource.data.studentId == request.auth.uid);
      allow write: if isOwnerOrAdmin() || isManager();
    }

    match /reminders/{reminderId} {
      allow read, write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read: if isOwnerOrAdmin() || isManager();
      allow write: if isOwnerOrAdmin() || isManager();
    }

    match /expenseCategories/{categoryId} {
      allow read: if isStaff();
      allow write: if isOwnerOrAdmin() || isManager();
    }

    match /visitors/{visitorId} {
      allow read, write: if isStaff();
    }

    match /visitorPurposes/{purposeId} {
      allow read, write: if isStaff();
    }

    match /seats/{seatId} {
      allow read: if isLoggedIn();
      allow create, delete: if isOwnerOrAdmin() || isManager();
      allow update: if isLoggedIn();
    }

    match /membershipPlans/{planId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    match /messageTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isOwnerOrAdmin();
    }

    match /messageLogs/{logId} {
      allow read, write: if isStaff();
    }

    match /test_connection/{docId} {
      allow read, write: if isLoggedIn();
    }

    match /globalDocuments/{docId} {
      allow read: if isLoggedIn();
      allow write: if isStaff();
    }

    match /announcements/{announcementId} {
      // All logged-in users can read announcements
      allow read: if isLoggedIn();
      allow write: if isStaff();
    }

    match /settings/{settingId} {
      // Public website visitors can read settings (website content, UPI QR), staff/admin can edit
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /Manager/{docId} {
      allow read: if isStaff() || (isLoggedIn() && request.auth.uid == docId);
      allow write: if isOwnerOrAdmin();
    }

    match /Employee/{docId} {
      allow read: if isStaff() || (isLoggedIn() && request.auth.uid == docId);
      allow write: if isOwnerOrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
